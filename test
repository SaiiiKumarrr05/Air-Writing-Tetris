import mediapipe as mp
import os

print(f"File location: {mp.__file__}")
try:
    print(f"Solutions: {mp.solutions}")
    print("SUCCESS: Solutions found!")
except AttributeError:
    print("FAILURE: 'solutions' still missing.")
    # Check if we are accidentally importing a local folder
    if "site-packages" not in mp.__file__:
        print(f"WARNING: You are importing MediaPipe from a local path: {os.path.dirname(mp.__file__)}")